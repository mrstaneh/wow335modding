diff -ruN orig/Interface/GlueXML/CharacterSelect.lua work/Interface/GlueXML/CharacterSelect.lua
--- orig/Interface/GlueXML/CharacterSelect.lua
+++ work/Interface/GlueXML/CharacterSelect.lua
@@ -162,6 +162,26 @@
 
 	--Clear out the addons selected item
 	GlueDropDownMenu_SetSelectedValue(AddonCharacterDropDown, ALL);
+
+	-- The browser build's guest account lives in the browser; saved with Discord it outlives the browser's data.
+	CharacterSelectDiscordButton:Hide();
+	CharacterSelectDiscordText:Hide();
+	CharacterSelectDeleteAccountButton:Hide();
+	if ( IsWebClient ) then
+		local discord = WebDiscordState();
+		if ( discord ~= nil ) then
+			CharacterSelectDeleteAccountButton:Show();
+		end
+		if ( discord == false ) then
+			CharacterSelectDiscordButton:Show();
+		elseif ( discord == "" ) then
+			CharacterSelectDiscordText:SetText(WEB_DISCORD_SAVED_UNNAMED);
+			CharacterSelectDiscordText:Show();
+		elseif ( discord ) then
+			CharacterSelectDiscordText:SetFormattedText(WEB_DISCORD_SAVED, discord);
+			CharacterSelectDiscordText:Show();
+		end
+	end
 end
 
 function CharacterSelect_OnHide()
@@ -447,6 +467,25 @@
 	EnterWorld();
 end
 
+-- Browser build: deletes the guest account with its characters and Discord link (WebDeleteAccount), then back to the
+-- login screen, where Play starts a new one.
+GlueDialogTypes["WEB_DELETE_ACCOUNT"] = {
+	text = WEB_DELETE_ACCOUNT_CONFIRM,
+	button1 = WEB_DELETE_ACCOUNT,
+	button2 = CANCEL,
+	showAlert = 1,
+	escapeHides = true,
+	OnAccept = function()
+		local deleted, message = WebDeleteAccount();
+		if ( deleted ) then
+			CharacterSelect_Exit();
+			GlueDialog_Show("OKAY", WEB_ACCOUNT_DELETED);
+		else
+			GlueDialog_Show("OKAY", message);
+		end
+	end,
+}
+
 function CharacterSelect_Exit()
 	PlaySound("gsCharacterSelectionExit");
 	DisconnectFromServer();
