+-- The browser build plays its guest account straight away when the page opens, once the client may log in (after
+-- the scan at start-up; until then DefaultServerLogin does nothing).
+function AccountLogin_WebAutoLogin()
+	if ( IsWebClient and IsScanDLLFinished() and WebAutoLogin() ) then
+		AccountLogin_PlayAsGuest();
+	end
+end
+
+-- The guest account this browser plays, created the first time (WebGuestAccount).
+function AccountLogin_PlayAsGuest()
+	local username, password = WebGuestAccount();
+	if ( not username ) then
+		GlueDialog_Show("OKAY", password);
+		return;
+	end
+	PlaySound("gsLogin");
+	DefaultServerLogin(username, password);
+end
+
 function AccountLogin_LaunchCommunitySite()
 	PlaySound("gsLoginNewAccount");
 	LaunchURL(COMMUNITY_URL);
