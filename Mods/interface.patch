+function AccountLogin_Register()
+	PlaySound("gsLoginNewAccount");
+	RegisterDialog:Show();
+end
+
+function RegisterDialog_Tab(self)
+	if ( self == RegisterDialogUsername ) then
+		RegisterDialogPassword:SetFocus();
+	elseif ( self == RegisterDialogPassword ) then
+		RegisterDialogConfirm:SetFocus();
+	else
+		RegisterDialogUsername:SetFocus();
+	end
+end
+
+-- Creates the account and logs in with it; the server checks the name and password rules and says what is wrong.
+function RegisterDialog_Create()
+	local username = RegisterDialogUsername:GetText();
+	local password = RegisterDialogPassword:GetText();
+	if ( password ~= RegisterDialogConfirm:GetText() ) then
+		RegisterDialogStatus:SetTextColor(1, 0.3, 0.3);
+		RegisterDialogStatus:SetText(REGISTER_PASSWORDS_DIFFER);
+		RegisterDialogConfirm:SetFocus();
+		return;
+	end
+	local status, message = WebRegisterAccount(username, password);
+	if ( status ~= 200 ) then
+		RegisterDialogStatus:SetTextColor(1, 0.3, 0.3);
+		RegisterDialogStatus:SetText(message);
+		return;
+	end
+	RegisterDialog:Hide();
+	AccountLoginAccountEdit:SetText(username);
+	AccountLoginPasswordEdit:SetText(password);
+	AccountLogin_Login();
+end
+
 function AccountLogin_LaunchCommunitySite()
 	PlaySound("gsLoginNewAccount");
 	LaunchURL(COMMUNITY_URL);
